+if is_there_enemy(enemy_data):
+    closest_enemy, enemy_distance = find_closest_enemy(enemy_data, player_pos, walls, "attack")
+else:
+    closest_enemy = None
+    enemy_distance = float('inf')
+
+enemies_nearby = count_enemies_in_area(enemy_data, player_pos, safe_range * 2)
+
+if enemies_nearby >= 2 and teammate_coords is not None:
+    direction_x = teammate_coords[0] - player_pos[0]
+    direction_y = teammate_coords[1] - player_pos[1]
+    movement = (direction_x, direction_y)
