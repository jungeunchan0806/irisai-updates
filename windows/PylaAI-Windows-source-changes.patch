diff --git a/Diagnose-Windows.bat b/Diagnose-Windows.bat
new file mode 100644
index 0000000..5e3d336
--- /dev/null
+++ b/Diagnose-Windows.bat
@@ -0,0 +1,7 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+if not exist ".venv\Scripts\python.exe" call Setup-Windows.bat --quiet
+set "PYTHONUTF8=1"
+".venv\Scripts\python.exe" -m pyla_addons.diagnostics
+pause
