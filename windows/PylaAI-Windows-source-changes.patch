diff --git a/tests/iris_input_support.py b/tests/iris_input_support.py
new file mode 100644
index 0000000..49bd590
--- /dev/null
+++ b/tests/iris_input_support.py
@@ -0,0 +1,20 @@
+import threading
+from unittest.mock import Mock
+from window_controller import WindowController
+
+def controller():
+    value = WindowController.__new__(WindowController)
+    value._move_lock = threading.RLock()
+    value.frame_lock = threading.Lock()
+    value.width, value.height = 1920, 1080
+    value.width_ratio = value.height_ratio = 1.0
+    value.joystick_x, value.joystick_y = 220, 870
+    value.PID_JOYSTICK, value.PID_ATTACK = 1, 2
+    value.are_we_moving = False
+    value.last_joystick_pos = (None, None)
+    value._last_joystick_press = 0.0
+    value._last_movement_log_time = 0.0
+    value.re_apply_movement = False
+    value.scrcpy_client = Mock(resolution=(1920, 1080))
+    value.reconnect_scrcpy = Mock(return_value=False)
+    return value
diff --git a/tests/test_auto_goal.py b/tests/test_auto_goal.py
new file mode 100644
index 0000000..5b8c969
--- /dev/null
+++ b/tests/test_auto_goal.py
@@ -0,0 +1,327 @@
+import math
+import unittest
+from unittest.mock import Mock, patch
+import cv2
+import numpy as np
+from brawl_ball import AutoGoal, BallObservation, BallVision, find_player_bar, path_waypoint, shooting_approach, find_brawl_ball_result
+from tests.iris_input_support import controller
+
+
+class AutoGoalTests(unittest.TestCase):
+    def setUp(self):
+        self.goal = AutoGoal()
+        self.window = Mock(width_ratio=1., height_ratio=1.)
+        self.window.aim_attack.return_value = True
+        self.frame = np.zeros((1080, 1920, 3), dtype=np.uint8)
+        # Player feet at (480, 300) in the normalized image.
+        self.data = {'player': [[864, 400, 1056, 653]], 'teammate': [], 'enemy': [], 'wall': []}
+
+    def observe(self, ball=(480, 270), goal=(480, 130), active=True):
+        self.goal.vision.observe = Mock(return_value=BallObservation(active, ball, goal, .9))
+
+    def test_other_modes_do_not_take_over_or_shoot(self):
+        self.observe(active=False)
+        self.assertIsNone(self.goal.decide(self.frame, self.data, self.window, 1))
+        self.window.aim_attack.assert_not_called()
+
+    def test_match_over_score_recovers_result_without_a_later_result_page(self):
+        from state_finder import get_state
+        for name,expected in [('last_goal','defeat'),('clock_expiry','victory'),
+                              ('last_goal_win','victory'),('clock_expiry_loss','defeat')]:
+            for size in ((960,540),(1280,720),(1920,1080)):
+                with self.subTest(name=name,size=size):
+                    frame=cv2.cvtColor(cv2.imread(f'tests/fixtures/brawl_ball/{name}.jpg'),cv2.COLOR_BGR2RGB)
+                    frame=cv2.resize(frame,size)
+                    self.assertEqual(find_brawl_ball_result(frame),expected)
+                    self.assertEqual(get_state(frame),'end_'+expected)
+
+    def test_result_requires_finished_banner_and_readable_score_on_both_sides(self):
+        for name in ('kickoff','rolling','highlight','held_turn'):
+            frame=cv2.cvtColor(cv2.imread(f'tests/fixtures/brawl_ball/{name}.jpg'),cv2.COLOR_BGR2RGB)
+            self.assertIsNone(find_brawl_ball_result(frame),name)
+        frame=cv2.cvtColor(cv2.imread('tests/fixtures/brawl_ball/last_goal.jpg'),cv2.COLOR_BGR2RGB)
+        frame[8:55,815:890]=0
+        self.assertIsNone(find_brawl_ball_result(frame))
+
+    def test_match_over_artwork_without_two_football_icons_cannot_report_a_result(self):
+        frame=cv2.cvtColor(cv2.imread('tests/fixtures/brawl_ball/last_goal.jpg'),cv2.COLOR_BGR2RGB)
+        frame[:65,:75]=0
+        self.assertIsNone(find_brawl_ball_result(frame))
+
+    def test_close_ball_must_be_confirmed_before_shooting(self):
+        self.observe()
+        self.goal.decide(self.frame, self.data, self.window, 1)
+        self.window.aim_attack.assert_not_called()
+        self.goal.decide(self.frame, self.data, self.window, 1.25)
+        self.window.aim_attack.assert_called_once_with(0., -170.)
+        self.window.release_movement.assert_called_once()
+
+    def test_own_goal_or_missing_goal_never_triggers_shot(self):
+        for target in ((480, 450), None):
