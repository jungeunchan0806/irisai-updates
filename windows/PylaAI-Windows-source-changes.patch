+    def test_progress_with_following_camera_does_not_trigger_escape(self):
+        r=MovementRecovery();frame=np.zeros((540,960,3),np.uint8)
+        r.camera.update=lambda *args:(0.,5.)
+        for i in range(20):
+            movement=r.adjust(frame,(480,300),(480,220),[],[],(0,-75),i*.2)
+        self.assertIsNone(r.escape)
+        self.assertEqual(movement,(0,-75))
+
+    def test_corner_escape_chooses_the_open_backwards_route(self):
+        r=MovementRecovery();r._world=np.array([480.,300.])
+        walls=[(440,240,520,270),(420,250,450,360),(510,250,540,360)]
+        r.choose_escape((480,300),(0,-75),walls,1)
+        self.assertGreater(r.escape[1],.9)
+        self.assertLess(abs(r.escape[0]),.1)
+
+    def test_failed_escape_is_not_repeated_forever(self):
+        r=MovementRecovery();r._world=np.array([480.,300.])
+        r.choose_escape((480,300),(0,-75),[],1)
+        first=r.escape;r.failed.append((2,first))
+        r.choose_escape((480,300),(0,-75),[],2)
+        self.assertLess(np.dot(first,r.escape),.8)
+
+    def test_escaping_overlapping_detection_can_move_out(self):
+        room=MovementRecovery.clearance((480,300),(-1,0),[(475,275,515,325)])
+        self.assertGreater(room,90)
+
+
+if __name__=='__main__':
+    unittest.main()
