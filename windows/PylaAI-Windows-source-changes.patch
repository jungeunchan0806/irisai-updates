new file mode 100644
index 0000000..574abef
--- /dev/null
+++ b/Setup-Windows.bat
@@ -0,0 +1,7 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0pyla_addons\setup_windows.ps1"
+set "result=%errorlevel%"
+if not "%~1"=="--quiet" pause
+exit /b %result%
diff --git a/Start-Windows.bat b/Start-Windows.bat
new file mode 100644
index 0000000..b4cd9d6
--- /dev/null
+++ b/Start-Windows.bat
@@ -0,0 +1,15 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+if exist ".venv\Scripts\python.exe" goto ready
+call Setup-Windows.bat --quiet
+if errorlevel 1 goto fail
+:ready
+set "PYTHONUTF8=1"
+".venv\Scripts\python.exe" -m pyla_addons.launcher %*
+if errorlevel 1 goto fail
+exit /b 0
+:fail
+ echo Startup failed. See the message above, or run Diagnose-Windows.bat.
+pause
+exit /b 1
