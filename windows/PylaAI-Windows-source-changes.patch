diff --git a/pyla_addons/launcher.py b/pyla_addons/launcher.py
new file mode 100644
index 0000000..ff50d45
--- /dev/null
+++ b/pyla_addons/launcher.py
@@ -0,0 +1,34 @@
+"""Apply source patches before importing the Windows startup/application code."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from .updater import app_lock, check_and_update, recover, DEFAULT_FEED
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    os.chdir(root)
+    with app_lock(root):
+        recover(root)
+        config_file = root / 'update-settings.json'
+        try:
+            config = json.loads(config_file.read_text(encoding='utf-8')) if config_file.exists() else {}
+            if config.get('auto_update', True):
+                print('Checking Windows patches...', flush=True)
+                check_and_update(root, config.get('manifest_url', DEFAULT_FEED))
+        except Exception as error:
+            recover(root)  # Do not start a partially patched installation.
+            print(f'Update unavailable; using installed version: {error}', flush=True)
+        # New process loads the newly installed startup code. The parent keeps the lock.
+        env = dict(os.environ, PYLA_MANAGED_LAUNCH='1', PYTHONUNBUFFERED='1')
+        return subprocess.call([sys.executable, '-m', 'pyla_addons.startup', *sys.argv[1:]], cwd=root, env=env)
+
+
+if __name__ == '__main__':
+    try:
+        raise SystemExit(main())
+    except Exception as error:
+        print(f'Startup failed: {error}', file=sys.stderr)
+        raise SystemExit(1)
diff --git a/pyla_addons/setup_windows.ps1 b/pyla_addons/setup_windows.ps1
new file mode 100644
index 0000000..14323af
--- /dev/null
+++ b/pyla_addons/setup_windows.ps1
@@ -0,0 +1,42 @@
+$ErrorActionPreference = 'Stop'
+Set-Location (Split-Path $PSScriptRoot -Parent)
+function Find-Python {
+    $ErrorActionPreference = 'SilentlyContinue'
+    $candidates = @(
+        "$env:LOCALAPPDATA\Programs\Python\Python311\python.exe",
+        "$env:ProgramFiles\Python311\python.exe"
+    )
+    if (Get-Command py -ErrorAction SilentlyContinue) {
+        $found = & py -3.11 -c "import sys; print(sys.executable)" 2>$null
+        if ($LASTEXITCODE -eq 0) { $candidates = @($found) + $candidates }
+    }
+    if (Get-Command python -ErrorAction SilentlyContinue) {
+        $candidates += (Get-Command python).Source
+    }
+    foreach ($candidate in $candidates) {
+        if (-not (Test-Path -LiteralPath $candidate)) { continue }
+        & $candidate -c "import sys,struct; sys.exit(0 if sys.version_info[:2] == (3,11) and struct.calcsize('P') == 8 else 1)" 2>$null
+        if ($LASTEXITCODE -eq 0) { return $candidate }
+    }
+    return $null
+}
+try {
+    $pythonExe = Find-Python
+    if (-not $pythonExe) {
+        if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
+            throw 'Install Python 3.11 x64 from python.org, then run Setup-Windows.bat again.'
+        }
+        Write-Host 'Installing Python 3.11 x64 for the current Windows user...'
+        & winget install --exact --id Python.Python.3.11 --scope user --architecture x64 --source winget --accept-source-agreements --accept-package-agreements
+        if ($LASTEXITCODE -ne 0) { throw 'Python installation failed. Install Python 3.11 x64 manually and retry.' }
+        $pythonExe = Find-Python
+        if (-not $pythonExe) { throw 'Python was installed but could not be located. Reopen Setup-Windows.bat.' }
+    }
+    & $pythonExe -m pyla_addons.bootstrap
+    if ($LASTEXITCODE -ne 0) { throw 'Dependency setup failed. Check the error above and retry.' }
+    Write-Host 'Setup complete. Run Start-Windows.bat.'
+    exit 0
+} catch {
+    Write-Host $_.Exception.Message -ForegroundColor Red
+    exit 1
+}
