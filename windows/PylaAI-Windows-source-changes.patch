diff --git a/.github/workflows/windows-checks.yml b/.github/workflows/windows-checks.yml
new file mode 100644
index 0000000..271f925
--- /dev/null
+++ b/.github/workflows/windows-checks.yml
@@ -0,0 +1,26 @@
+name: Windows gameplay and patch checks
+on:
+  workflow_dispatch:
+  push:
+    paths:
+      - '**.py'
+      - 'pyla_addons/**'
+      - 'images/brawl_ball/**'
+      - 'playstyles/iris_*.pyla'
+      - '.github/workflows/windows-checks.yml'
+jobs:
+  tests:
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+          architecture: x64
+      - run: python -m pip install -r requirements.txt pytest
+      - run: python -m pytest -q tests
+      - run: python -m pyla_addons.build_patch --output patch-release --version 0.1.0
+      - uses: actions/upload-artifact@v4
+        with:
+          name: PylaAI-Windows-AutoPatch
+          path: patch-release/PylaAI-Windows-AutoPatch.zip
