+    private void checkSavedChoice() {
+        List<Boolean> requests = new ArrayList<>();
+        IrisControlPanel.Actions actions = new IrisControlPanel.Actions() {
+            public boolean nativeEngine() { return true; }
+            public void requestAutoGoal(boolean selected) { requests.add(selected); }
+            public void toggleAutoGoal() { throw new AssertionError("Expected an explicit button choice"); }
+            public void calibrate() {}
+            public void resetControls() {}
+            public void visibilitySuppressed() {}
+        };
+        IrisControlPanel panel = new IrisControlPanel(activity, actions, false);
+        panel.resume();
+        TextView button = (TextView) byDescription(panel, "Toggle Auto Goal");
+        button.performClick();
+        panel.setEngineState(true, "게임 상태 갱신 대기");
+        panel.setConnectionState("stalled");
+        require(button.getText().toString().contains("Setting ON"), "stall preserves the ON selection");
+        panel.setEngineState(false, "UI 응답 없음 · 오류 확인");
+        require(button.getText().toString().contains("Setting ON") && button.getText().toString().contains("Inactive"),
+                "selected ON and inactive runtime are distinguishable");
+        panel.pause();
+        panel.close();
