+import {db, json, hash, event, createLicense, type LicenseRow} from './license-server';
+import {statusOf} from './license-domain';
+import {deviceProof} from './device-proof';
+
+const plans = ['Practice', 'Plus'];
+const planOf = (note: string) => plans.find(p => note === 'theseven/' + p) || 'Practice';
+const attempts = new Map<string, {end:number,count:number}>();
+function limited(r: Request) {
+  const ip = r.headers.get('cf-connecting-ip') || 'local', now = Date.now();
+  if (attempts.size > 4096) for (const [id,v] of attempts) if (v.end <= now) attempts.delete(id);
+  let entry = attempts.get(ip);
+  if (!entry || entry.end <= now) {entry = {end:now+60000,count:0}; attempts.set(ip,entry);}
+  return ++entry.count > 90;
+}
+async function request(r: Request) {
+  if (!r.headers.get('content-type')?.startsWith('application/json')) throw Error();
+  const raw = await r.text();
+  if (raw.length > 4096) throw Error();
+  const device = await deviceProof(r, raw);
+  return {device, data:JSON.parse(raw)};
+}
+function subscription(row: LicenseRow | null) {
+  return json({status:row?statusOf(row):'unregistered',plan:row?planOf(row.note):null,
+    expiresAt:row?.expires_at??null,permanent:!!row?.permanent,serverTime:Date.now()});
+}
+export async function buyer(r: Request) {
+  if (limited(r)) return json({status:'rate_limited'},429);
+  try {
+    const {device,data} = await request(r);
+    if (device?.platform !== 'apk') return json({status:'device_error'},401);
+    const hwid = 'BS-' + device.hash.toUpperCase();
+    if (data.action === 'check') return subscription(await db().prepare('SELECT * FROM licenses WHERE hwid=?').bind(hwid).first<LicenseRow>());
+    if (data.action !== 'redeem') return json({status:'invalid'},400);
+    const raw = typeof data.key === 'string' ? data.key.trim().toUpperCase() : '';
+    if (!/^BSK-(?:[A-F0-9]{8}-){5}[A-F0-9]{8}$/.test(raw)) return json({status:'invalid'},400);
+    const row = await db().prepare('SELECT * FROM licenses WHERE key_hash=?').bind(await hash(raw)).first<LicenseRow>();
+    if (!row) return json({status:'invalid'},404);
+    if (['expired','revoked'].includes(statusOf(row))) return subscription(row);
+    if (row.hwid && row.hwid !== hwid) return json({status:'bound'},409);
+    if (!row.hwid) {
+      const now = Date.now();
+      try {await db().prepare('UPDATE licenses SET hwid=?,activated_at=COALESCE(activated_at,?),expires_at=CASE WHEN permanent=1 THEN NULL ELSE COALESCE(expires_at,?+duration_ms) END,updated_at=? WHERE id=? AND revoked=0 AND hwid IS NULL AND (expires_at IS NULL OR expires_at>?)').bind(hwid,now,now,now,row.id,now).run();}
+      catch {return json({status:'device_conflict'},409);}
+    }
+    const latest = await db().prepare('SELECT * FROM licenses WHERE id=?').bind(row.id).first<LicenseRow>();
+    if (latest && ['revoked','expired'].includes(statusOf(latest))) return subscription(latest);
+    return latest?.hwid===hwid?subscription(latest):json({status:'bound'},409);
+  } catch {return json({status:'service_error'},503);}
+}
+export async function dealer(r: Request) {
+  if (limited(r)) return json({status:'rate_limited'},429);
+  try {
+    const {device,data} = await request(r);
+    if (device?.platform !== 'apk') return json({status:'device_error'},401);
+    const now = Date.now(), note = 'theseven:'+device.hash;
+    const row = await db().prepare("SELECT id,group_id FROM seller_keys WHERE platform='apk' AND note=? AND revoked=0 AND (device_hash IS NULL OR device_hash=?) AND (expires_at IS NULL OR expires_at>?) ORDER BY created_at DESC LIMIT 1").bind(note,device.hash,now).first<{id:string,group_id:string}>();
+    if (!row) return json({status:'unapproved'},403);
+    await db().prepare('UPDATE seller_keys SET device_hash=?,activated_at=?,expires_at=CASE WHEN permanent=1 THEN NULL ELSE COALESCE(expires_at,?+duration_ms) END,updated_at=? WHERE id=? AND activated_at IS NULL AND revoked=0').bind(device.hash,now,now,now,row.id).run();
+    const grant = await db().prepare("SELECT id FROM seller_keys WHERE id=? AND note=? AND device_hash=? AND revoked=0 AND (permanent=1 OR expires_at>?)").bind(row.id,note,device.hash,now).first();
+    if (!grant) return json({status:'unapproved'},403);
+    const owner = row.group_id||row.id;
+    if (data.action==='history') {
+      const {results} = await db().prepare('SELECT id,created_at,expires_at,revoked,permanent,hwid,note FROM licenses WHERE seller_id=? ORDER BY created_at DESC LIMIT 500').bind(owner).all<LicenseRow>();
+      return json({status:'approved',history:results.map(v=>({id:v.id,created:v.created_at,expires:v.expires_at,plan:planOf(v.note),status:statusOf(v)}))});
+    }
+    if (data.action==='issue') {
+      if (!plans.includes(data.plan)||!Number.isInteger(data.days)||data.days<1||data.days>3650) return json({status:'invalid_term'},400);
+      return createLicense({note:'theseven/'+data.plan,term:{kind:'until',value:new Date(now+data.days*86400000).toISOString()}},owner);
+    }
+    if (['revoke','restore','delete'].includes(data.action) && typeof data.id==='string') {
+      const owned=await db().prepare('SELECT id FROM licenses WHERE id=? AND seller_id=?').bind(data.id,owner).first();
+      if (!owned) return json({status:'missing'},404);
+      const mutation=data.action==='delete'?db().prepare('DELETE FROM licenses WHERE id=? AND seller_id=?').bind(data.id,owner):db().prepare('UPDATE licenses SET revoked=?,updated_at=? WHERE id=? AND seller_id=?').bind(data.action==='revoke'?1:0,now,data.id,owner);
+      await db().batch([mutation,event(data.id,'theseven_'+data.action,now)]);
+      return json({status:'ok'});
+    }
+    return json({status:'invalid'},400);
+  } catch {return json({status:'service_error'},503);}
+}
