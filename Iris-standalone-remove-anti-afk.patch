+
+test('connection loss cancels pending and running requests across recovery', () => {
+  for (const running of [false, true]) {
+    const fixture = panelFixture({active: true});
+    fixture.poll(1);
+    if (running) {
+      fixture.activate();
+      fixture.poll();
+      assert.equal(fixture.c._ag.enabled, true);
+    }
+
+    let network = 'offline';
+    fixture.c.fake.connectionStatus = () => JSON.stringify({network, focused: true, generation: 2});
+    fixture.poll();
+    assert.equal(fixture.c._ag.enabled, false);
+    network = 'online';
+    fixture.activate(); // A delayed response to the old request.
+    fixture.poll();
+    assert.equal(fixture.c._ag.enabled, false);
+  }
+});
